{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "api/upload.ts",
    "api/whatsapp.ts",
    "api/whatsapp-simulate.ts",
    "api/whatsapp-notify.ts",
    "api/lib/**/*.d.ts"
  ]
}
