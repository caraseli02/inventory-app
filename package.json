{
  "name": "inventory-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "typecheck": "tsc -b --noEmit && tsc --project tsconfig.api.json --noEmit && tsc --project mcp/tsconfig.server.json --noEmit",
    "mcp:typecheck": "tsc --project mcp/tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --coverage.thresholdAutoUpdate=false",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:ui": "playwright test --config=playwright.visual.config.ts --ui",
    "audit:check": "node scripts/audit-check.js",
    "validate-docs": "node scripts/validate-docs.js",
    "check-root-files": "node scripts/check-root-files.js",
    "pr:sync-body": "node scripts/sync-pr-body.js",
    "pr:check-body": "node scripts/sync-pr-body.js --check",
    "prepare": "simple-git-hooks",
    "mcp:build": "vite build --config mcp/vite.config.ts",
    "mcp:serve": "tsx mcp/main.ts",
    "mcp:stdio": "tsx mcp/main.ts --stdio",
    "mcp:smoke": "tsx scripts/mcp-smoke-test.ts",
    "whatsapp:eval": "tsx scripts/whatsapp-sim-eval.ts",
    "whatsapp:eval:followup": "tsx scripts/whatsapp-sim-followup-eval.ts",
    "whatsapp:replay": "tsx scripts/whatsapp-replay.ts",
    "whatsapp:test": "tsx scripts/whatsapp-local-test.ts",
    "whatsapp:test:webhook": "tsx scripts/test-whatsapp-webhook-local.ts",
    "whatsapp:test:all": "pnpm test:integration -- tests/integration/whatsapp-agent.test.ts"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "picomatch": "4.0.4",
      "micromatch>picomatch": "2.3.2",
      "router>path-to-regexp": "8.4.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "flatted": ">=3.4.0",
      "serialize-javascript": ">=7.0.3",
      "undici": ">=6.24.0",
      "@ts-morph/common>minimatch": ">=3.1.4",
      "@eslint/config-array>minimatch": ">=3.1.4",
      "@eslint/eslintrc>minimatch": ">=3.1.4",
      "eslint>minimatch": ">=3.1.4",
      "@vercel/python-analysis>minimatch": ">=10.2.3",
      "@modelcontextprotocol/sdk>hono": ">=4.12.4",
      "@modelcontextprotocol/sdk>@hono/node-server": ">=1.19.10",
      "@modelcontextprotocol/sdk>express-rate-limit": ">=8.2.2"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check-root-files && pnpm validate-docs && pnpm typecheck && pnpm lint",
    "pre-push": "pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@anthropic-ai/sdk": "^0.78.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@supabase/supabase-js": "^2.88.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/blob": "^2.3.1",
    "@vercel/functions": "^3.4.3",
    "ai": "^6.0.116",
    "airtable": "^0.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.7.2",
    "lucide-react": "^0.556.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.4.0",
    "react-router-dom": "6.30.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.15",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-sonarjs": "^1.0.4",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.3.0",
    "msw": "^2.12.10",
    "playwright": "^1.57.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.18"
  }
}
