# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# The app automatically detects which backend to use based on which env vars
# are set. If both are set, Supabase takes priority.
#
# Choose ONE backend: Supabase (recommended) OR Airtable (legacy)

# --- Option 1: Supabase (RECOMMENDED) 🌟 ---
#
# Why Supabase?
# ✅ Open source & self-hostable
# ✅ Built-in authentication with Row Level Security (RLS)
# ✅ Real-time subscriptions
# ✅ Free tier: 500MB database, 50,000 monthly active users
# ✅ Safe to expose client-side (publishable key is protected by RLS)
#
# Setup Guide: docs/SUPABASE_SETUP.md
#
# Get your credentials:
# 1. Go to: https://app.supabase.com
# 2. Select your project → Settings → API
# 3. Copy these two values:
#    - Project URL
#    - anon/public key (also called "publishable" key)
#
# ⚠️ IMPORTANT: Use the "anon" or "publishable" key, NOT the "service_role" key!
# The service_role key is for backend use only and should NEVER be exposed.
#
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Use either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY (same key, both work)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Option 2: Airtable (LEGACY) ---
#
# Note: Airtable support is maintained for backward compatibility.
# New projects should use Supabase.
#
# Migration Guide: docs/MIGRATION_GUIDE.md
#
# Get your credentials:
# 1. Go to: https://airtable.com/account
# 2. Generate a personal access token with read/write scope
# 3. Copy your base ID from the base URL (appXXXXXXXXXXXXXX)
#
# ⚠️ SECURITY WARNING: Airtable credentials are exposed in the client bundle.
# Only use this for MVP testing with trusted users.
# For production, migrate to Supabase or implement a backend proxy.
#
# VITE_AIRTABLE_API_KEY=patAbcd1234567890...
# VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# =============================================================================
# IMAGE UPLOAD (Optional - for camera capture feature)
# =============================================================================
# The app supports two methods for uploading product images:
# 1. URL input - Paste any image URL directly (no upload needed)
# 2. Camera capture - Take a photo with device camera (requires upload)
#
# Upload Strategy:
# - Production (Vercel): Uses Vercel Blob storage automatically
# - Development (Local): Falls back to imgbb.com free image hosting
#
# Setup:
# - For local development: Get a free API key at https://api.imgbb.com/
# - For production: Add BLOB_READ_WRITE_TOKEN in Vercel dashboard
#
VITE_IMGBB_API_KEY=your_imgbb_api_key_here

# Production (Vercel Blob):
# 1. Deploy to Vercel once to provision blob storage
# 2. Go to: Vercel dashboard → Settings → Environment Variables
# 3. Add: BLOB_READ_WRITE_TOKEN (generated automatically by Vercel)
# 4. To test locally: vercel link && vercel env pull .env.local

# =============================================================================
# INVOICE OCR & DATA EXTRACTION (Optional - for automatic invoice import)
# =============================================================================
# Feature: Upload invoice PDFs and automatically extract product data
# Saves 90-95% of manual data entry time (15-40 min → 1-2 min per invoice)
#
# How it works:
# 1. FastAPI service extracts text and data from PDF invoice
# 2. Returns structured product data with names, quantities, and prices
# 3. Review and edit products before importing
#
# Architecture: Browser -> FastAPI (direct) -> Processing
# - FastAPI validates Supabase JWT tokens
# - FastAPI receives multipart/form-data uploads directly
# - Returns JSON with products, supplier, invoice number, and total amount
#
# Setup Guide: docs/FASTAPI_INTEGRATION.md
#
# --- FastAPI Service Configuration ---
# FastAPI Service URL (production):
VITE_INVOICE_API_URL=https://your-fastapi-production.com
#
# Development only - local FastAPI instance:
# VITE_INVOICE_API_URL=http://localhost:8000
#
# Development only - API key for local testing (NEVER commit to production):
# VITE_DEV_INVOICE_API_KEY=dev-key-for-local-testing
#
# Notes:
# - Browser sends Bearer token to FastAPI directly
# - JWT validation happens on FastAPI side (Supabase SDK)
# - No API keys in production bundle
# - Faster: No proxy hop, no cold starts

# =============================================================================
# SECURITY REMINDER
# =============================================================================
# ⚠️ NEVER commit a real .env file to the repository!
#
# Setup:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. The .env file is gitignored by default
#
# Production:
# - Set environment variables in your hosting platform (Vercel, Netlify, etc.)
# - Never hardcode credentials in source code
# - Use Vercel's environment variable management for sensitive keys

# ─── WhatsApp Agent (Twilio) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# With or without leading +, no "whatsapp:" prefix (code adds it)
# Sandbox number example: +14155238886
TWILIO_FROM_NUMBER=+14155238886
# Optional store info injected into Claude system prompt
STORE_NAME=Magazinul Verde
STORE_ADDRESS=Str. Florilor 12, Cluj-Napoca
STORE_HOURS=Luni-Vineri 8-20, Sambata 9-18
STORE_PHONE=+40123456789

# Shared secret for /api/whatsapp-notify — must match on client (VITE_) and server.
# Generate with: openssl rand -hex 32
VITE_NOTIFY_SECRET=your-random-secret-here

# Supabase env vars without VITE_ prefix — preferred for serverless functions.
# Set these alongside VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
